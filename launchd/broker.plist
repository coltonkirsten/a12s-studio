<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.a12s-studio.broker</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{node}}</string>
    <string>{{repo}}/packages/broker/src/main.ts</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>STUDIO_HOME</key>
    <string>{{home}}</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>{{repo}}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{logs}}/broker.log</string>
  <key>StandardErrorPath</key>
  <string>{{logs}}/broker.log</string>
</dict>
</plist>
